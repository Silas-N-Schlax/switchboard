{
  "manifest_version": 3,
  "name": "Switchboard",
  "version": "0.1.0",
  "description": "A minimal, keyboard-first New Tab replacement — local link workspaces, no bookmarks, no cloud.",
  "icons": {
    "16": "graphics/extension/icon-16.png",
    "32": "graphics/extension/icon-32.png",
    "48": "graphics/extension/icon-48.png",
    "128": "graphics/extension/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "alarms",
    "favicon"
  ],
  "optional_permissions": [
    "history"
  ]
}
